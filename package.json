{
  "name": "martinlauncher",
  "version": "2.0.6",
  "description": "Launcher Minecraft personalizado",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "keywords": [],
  "author": "Martin",
  "license": "ISC",
  "type": "commonjs",
  "build": {
    "appId": "com.fomeland.launcher",
    "productName": "FomeLand Launcher",
    "files": [
      "**/*",
      "!downloads/**",
      "!dist/**",
      "!.git/**",
      "!*.log"
    ],
    "publish": {
      "provider": "github",
      "owner": "HekerKiller",
      "repo": "FomeLandLauncherClean"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/logo.ico"
    },
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FomeLand Launcher"
    }
  },
  "devDependencies": {
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@xmcl/core": "^2.15.1",
    "adm-zip": "^0.6.0",
    "axios": "^1.20.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "minecraft-launcher-core": "^3.18.2"
  }
}